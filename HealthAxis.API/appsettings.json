{
  "AppSettings": {
    "AppName": "HealthAxis API"
  },
  "ConnectionStrings": {
    "HealthAxisDb": "Server=.;Database=HealthAxisDb;User Id=nev;Password=pass;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Issuer": "HealthAxis.API",
    "Audience": "HealthAxis.Client",
    "Key": "HealthAxis-Sprint3-Jwt-Secret-Key-For-Training-Only-Change-Later",
    "AccessTokenExpirationMinutes": 15
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Enrichers.Environment"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/healthaxis-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentName",
      "WithEnvironmentUserName"
    ],
    "Properties": {
      "Application": "HealthAxis API"
    }
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "AppointmentBookedQueue": "appointment.booked.queue"
  },
  "Garnet": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "HealthAxis:"
  },
  "AllowedHosts": "*"
}

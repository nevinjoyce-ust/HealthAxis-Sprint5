<span class="status-badge @CssClass">@Text</span>

@code {
    [Parameter]
    public string Text { get; set; } = string.Empty;

    [Parameter]
    public string Variant { get; set; } = "neutral";

    private string CssClass => Variant.ToLowerInvariant() switch
    {
        "success" => "status-success",
        "warning" => "status-warning",
        "danger" => "status-danger",
        "info" => "status-info",
        _ => "status-neutral"
    };
}

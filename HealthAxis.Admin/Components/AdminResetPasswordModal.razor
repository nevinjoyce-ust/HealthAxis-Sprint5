@using HealthAxis.Shared.Dtos.Auth

@if (IsOpen)
{
    <div class="modal-backdrop-custom">
        <section class="confirm-modal-card">
            <div class="confirm-modal-icon">
                <span class="bi bi-key" aria-hidden="true"></span>
            </div>

            <h3>@Title</h3>

            @if (!string.IsNullOrWhiteSpace(Description))
            {
                <p>@Description</p>
            }

            <EditForm Model="ResetPasswordForm" OnValidSubmit="ConfirmAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3 text-start">
                    <label class="form-label">New password</label>
                    <InputText class="form-control"
                               type="password"
                               @bind-Value="ResetPasswordForm.NewPassword" />
                </div>

                <div class="mb-3 text-start">
                    <label class="form-label">Confirm new password</label>
                    <InputText class="form-control"
                               type="password"
                               @bind-Value="ResetPasswordForm.ConfirmNewPassword" />
                </div>

                <div class="form-actions">
                    <button class="btn btn-warning"
                            type="submit"
                            disabled="@IsSaving">
                        @(IsSaving ? "Resetting..." : ConfirmButtonText)
                    </button>

                    <button class="btn btn-outline-secondary"
                            type="button"
                            disabled="@IsSaving"
                            @onclick="CloseAsync">
                        Cancel
                    </button>
                </div>
            </EditForm>
        </section>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public AdminResetPasswordDto ResetPasswordForm { get; set; } = new();
    [Parameter] public bool IsSaving { get; set; }
    [Parameter] public string Title { get; set; } = "Reset password";
    [Parameter] public string? Description { get; set; } = "Set a new password for this account. The current password is not required.";
    [Parameter] public string ConfirmButtonText { get; set; } = "Reset Password";
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private async Task ConfirmAsync()
    {
        await OnConfirm.InvokeAsync();
    }

    private async Task CloseAsync()
    {
        await OnClose.InvokeAsync();
    }
}
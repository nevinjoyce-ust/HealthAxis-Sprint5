@using Microsoft.AspNetCore.Components.Forms
@using HealthAxis.Shared.Dtos.Auth

@if (IsOpen)
{
    <div class="modal-backdrop-custom">
        <section class="confirm-modal-card">
            <h3>@Title</h3>

            @if (!string.IsNullOrWhiteSpace(Description))
            {
                <p>@Description</p>
            }

            <EditForm EditContext="_editContext"
                      OnValidSubmit="ConfirmAsync"
                      OnInvalidSubmit="HandleInvalidSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary />

                @if (!string.IsNullOrWhiteSpace(_localErrorMessage))
                {
                    <div class="alert alert-danger mt-3">@_localErrorMessage</div>
                }

                @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                {
                    <div class="alert alert-danger mt-3">@ErrorMessage</div>
                }

                <div class="profile-form-stack">
                    <div>
                        <label class="form-label">New password</label>
                        <InputText class="form-control"
                                   type="password"
                                   @bind-Value="ResetPasswordForm.NewPassword" />
                        <ValidationMessage For="@(() => ResetPasswordForm.NewPassword)" />
                        <div class="form-text">
                            Must be 8-100 characters and include uppercase, lowercase, number, and special character.
                        </div>
                    </div>

                    <div>
                        <label class="form-label">Confirm new password</label>
                        <InputText class="form-control"
                                   type="password"
                                   @bind-Value="ResetPasswordForm.ConfirmNewPassword" />
                        <ValidationMessage For="@(() => ResetPasswordForm.ConfirmNewPassword)" />
                    </div>
                </div>

                <div class="form-actions">
                    <button class="btn btn-soft-warning"
                            type="submit"
                            disabled="@IsSaving">
                        @(IsSaving ? "Resetting..." : ConfirmButtonText)
                    </button>

                    <button class="btn btn-soft-secondary"
                            type="button"
                            disabled="@IsSaving"
                            @onclick="CloseAsync">
                        Cancel
                    </button>
                </div>
            </EditForm>
        </section>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public AdminResetPasswordDto ResetPasswordForm { get; set; } = new();
    [Parameter] public bool IsSaving { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public string Title { get; set; } = "Reset password";
    [Parameter] public string? Description { get; set; } = "Set a new password for this account. The current password is not required.";
    [Parameter] public string ConfirmButtonText { get; set; } = "Reset";
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private EditContext _editContext = default!;
    private AdminResetPasswordDto? _previousForm;
    private string? _localErrorMessage;

    protected override void OnParametersSet()
    {
        if (_editContext is null || !ReferenceEquals(_previousForm, ResetPasswordForm))
        {
            _previousForm = ResetPasswordForm;
            _editContext = new EditContext(ResetPasswordForm);
            _localErrorMessage = null;
        }
    }

    private async Task ConfirmAsync()
    {
        _localErrorMessage = null;

        if (!IsStrongPassword(ResetPasswordForm.NewPassword))
        {
            _localErrorMessage = "New password must include uppercase, lowercase, number, and special character.";
            return;
        }

        await OnConfirm.InvokeAsync();
    }

    private void HandleInvalidSubmit()
    {
        _localErrorMessage = "Please correct the highlighted fields before resetting the password.";
    }

    private async Task CloseAsync()
    {
        _localErrorMessage = null;
        await OnClose.InvokeAsync();
    }

    private static bool IsStrongPassword(string password)
    {
        return password.Length is >= 8 and <= 100 &&
            password.Any(char.IsUpper) &&
            password.Any(char.IsLower) &&
            password.Any(char.IsDigit) &&
            password.Any(character => !char.IsLetterOrDigit(character));
    }
}

@if (IsOpen)
{
    <div class="modal-backdrop-custom">
        <section class="confirm-modal-card confirm-modal-card-danger">
            <h3>@Title</h3>

            @if (!string.IsNullOrWhiteSpace(Message))
            {
                <p>@((MarkupString)Message)</p>
            }

            @if (!string.IsNullOrWhiteSpace(SecondaryMessage))
            {
                <p class="text-muted mb-0">@((MarkupString)SecondaryMessage)</p>
            }

            @if (ChildContent is not null)
            {
                <div class="mt-3">
                    @ChildContent
                </div>
            }

            <div class="form-actions">
                <button class="@ConfirmButtonClass"
                        type="button"
                        disabled="@IsBusy"
                        @onclick="ConfirmAsync">
                    @(IsBusy ? BusyText : ConfirmText)
                </button>

                <button class="btn btn-soft-secondary"
                        type="button"
                        disabled="@IsBusy"
                        @onclick="CancelAsync">
                    @CancelText
                </button>
            </div>
        </section>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string Title { get; set; } = "Confirm action";
    [Parameter] public string? Message { get; set; }
    [Parameter] public string? SecondaryMessage { get; set; }
    [Parameter] public string IconCssClass { get; set; } = string.Empty;
    [Parameter] public string ConfirmText { get; set; } = "Confirm";
    [Parameter] public string BusyText { get; set; } = "Working...";
    [Parameter] public string CancelText { get; set; } = "Cancel";
    [Parameter] public string ConfirmButtonClass { get; set; } = "btn btn-soft-danger";
    [Parameter] public bool IsBusy { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private async Task ConfirmAsync()
    {
        await OnConfirm.InvokeAsync();
    }

    private async Task CancelAsync()
    {
        await OnCancel.InvokeAsync();
    }
}

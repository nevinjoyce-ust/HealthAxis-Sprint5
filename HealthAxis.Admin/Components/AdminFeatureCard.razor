<div class="admin-feature-card card shadow-sm h-100">
    <div class="card-body">
        <h5>@Title</h5>
        <p class="text-muted">@Description</p>
        <span class="badge @BadgeCssClass">@BadgeText</span>
    </div>
</div>

@code {
    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string Description { get; set; } = string.Empty;

    [Parameter]
    public string BadgeText { get; set; } = "Pending";

    [Parameter]
    public string BadgeCssClass { get; set; } = "bg-warning text-dark";
}
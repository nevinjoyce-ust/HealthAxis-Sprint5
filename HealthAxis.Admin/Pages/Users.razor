@page "/users"
@using HealthAxis.Admin.Components
@using HealthAxis.Admin.Models

<PageTitle>Users - HealthAxis Admin</PageTitle>

<AdminPageHeader Kicker="User Management"
                 Title="Registered Users"
                 Description="View registered user accounts. Patient and doctor details are shown only for those roles." />

<section class="admin-card mb-4">
    <div class="filter-row">
        <div>
            <label class="form-label">Filter by role</label>
            <select class="form-select" @bind="_selectedRole">
                <option value="All">All</option>
                <option value="Admin">Admin</option>
                <option value="Doctor">Doctor</option>
                <option value="Patient">Patient</option>
            </select>
        </div>
    </div>
</section>

<section class="admin-card">
    <div class="table-responsive">
        <table class="table admin-table user-table align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th class="user-view-header">Details</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in FilteredUsers)
                {
                    <tr>
                        <td>@user.FullName</td>
                        <td>@user.Email</td>
                        <td>
                            <StatusBadge Text="@user.Role" Variant="@GetRoleVariant(user.Role)" />
                        </td>
                        <td class="user-view-cell">
                            @if (user.Role == "Admin")
                            {
                                <span class="text-muted">—</span>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-primary compact-edit-button"
                                        type="button"
                                        @onclick="() => ViewUser(user)">
                                    View
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

@if (_selectedUser is not null)
{
    <div class="modal-backdrop-custom">
        <section class="user-detail-modal-card">
            <div class="user-detail-header">
                <div>
                    <p class="admin-page-kicker">@_selectedUser.Role Details</p>
                    <h3>@_selectedUser.FullName</h3>
                    <p class="text-muted mb-0">@_selectedUser.Email</p>
                </div>
                <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="CloseUserDetails">
                    Close
                </button>
            </div>

            <div class="detail-grid">
                <div class="detail-item">
                    <span>Full name</span>
                    <strong>@_selectedUser.FullName</strong>
                </div>
                <div class="detail-item">
                    <span>Email</span>
                    <strong>@_selectedUser.Email</strong>
                </div>
                <div class="detail-item">
                    <span>Phone</span>
                    <strong>@_selectedUser.PhoneNumber</strong>
                </div>
                <div class="detail-item">
                    <span>Role</span>
                    <strong>@_selectedUser.Role</strong>
                </div>

                @if (_selectedUser.Role == "Patient" && SelectedPatient is not null)
                {
                    <div class="detail-item">
                        <span>Date of birth</span>
                        <strong>@SelectedPatient.DateOfBirth.ToString("dd MMM yyyy")</strong>
                    </div>
                    <div class="detail-item">
                        <span>Gender</span>
                        <strong>@SelectedPatient.Gender</strong>
                    </div>
                    <div class="detail-item detail-item-wide">
                        <span>Address</span>
                        <strong>@SelectedPatient.Address</strong>
                    </div>
                }
                else if (_selectedUser.Role == "Doctor" && SelectedDoctor is not null)
                {
                    <div class="detail-item">
                        <span>Specialisation</span>
                        <strong>@SelectedDoctor.Specialisation</strong>
                    </div>
                    <div class="detail-item">
                        <span>Practice start date</span>
                        <strong>@SelectedDoctor.PracticeStartDate.ToString("dd MMM yyyy")</strong>
                    </div>
                    <div class="detail-item">
                        <span>Experience</span>
                        <strong>@SelectedDoctor.YearsOfExperience years</strong>
                    </div>
                    <div class="detail-item">
                        <span>Consultation fee</span>
                        <strong>₹@SelectedDoctor.ConsultationFee</strong>
                    </div>
                    <div class="detail-item">
                        <span>Availability</span>
                        <strong>@(SelectedDoctor.IsAvailable ? "Available" : "Unavailable")</strong>
                    </div>
                }
            </div>
        </section>
    </div>
}

@code {
    private string _selectedRole = "All";
    private User? _selectedUser;

    private readonly List<User> _users = new()
    {
        new() { Id = 1, FullName = "Admin User", Email = "admin@healthaxis.com", PhoneNumber = "+91 98765 40001", Role = "Admin" },
        new() { Id = 2, FullName = "Dr. Ananya Menon", Email = "ananya@healthaxis.com", PhoneNumber = "+91 98765 40002", Role = "Doctor" },
        new() { Id = 3, FullName = "Dr. Rohan Mathew", Email = "rohan@healthaxis.com", PhoneNumber = "+91 98765 40003", Role = "Doctor" },
        new() { Id = 4, FullName = "Nevin Joyce", Email = "nevin@example.com", PhoneNumber = "+91 98765 40004", Role = "Patient" },
        new() { Id = 5, FullName = "Asha Thomas", Email = "asha@example.com", PhoneNumber = "+91 98765 40005", Role = "Patient" }
    };

    private readonly List<Doctor> _doctors = new()
    {
        new() { Id = 1, FullName = "Dr. Ananya Menon", Specialisation = "Cardiology", PracticeStartDate = new DateOnly(2014, 6, 1), YearsOfExperience = 12, ConsultationFee = 750, IsAvailable = true },
        new() { Id = 2, FullName = "Dr. Rohan Mathew", Specialisation = "Orthopaedics", PracticeStartDate = new DateOnly(2017, 4, 15), YearsOfExperience = 9, ConsultationFee = 650, IsAvailable = true }
    };

    private readonly List<Patient> _patients = new()
    {
        new() { Id = 1, UserId = 4, FullName = "Nevin Joyce", DateOfBirth = new DateOnly(1998, 5, 12), Gender = "Male", Address = "Trivandrum, Kerala" },
        new() { Id = 2, UserId = 5, FullName = "Asha Thomas", DateOfBirth = new DateOnly(1995, 11, 3), Gender = "Female", Address = "Kochi, Kerala" }
    };

    private IEnumerable<User> FilteredUsers =>
        _selectedRole == "All"
            ? _users
            : _users.Where(user => user.Role == _selectedRole);

    private Doctor? SelectedDoctor =>
        _selectedUser is null
            ? null
            : _doctors.FirstOrDefault(doctor => doctor.FullName == _selectedUser.FullName);

    private Patient? SelectedPatient =>
        _selectedUser is null
            ? null
            : _patients.FirstOrDefault(patient => patient.UserId == _selectedUser.Id);

    private static string GetRoleVariant(string role)
    {
        return role switch
        {
            "Admin" => "info",
            "Doctor" => "success",
            "Patient" => "neutral",
            _ => "neutral"
        };
    }

    private void ViewUser(User user)
    {
        if (user.Role == "Admin")
        {
            return;
        }

        _selectedUser = user;
    }

    private void CloseUserDetails()
    {
        _selectedUser = null;
    }
}

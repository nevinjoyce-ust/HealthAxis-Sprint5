@page "/admin-profile"
@attribute [Authorize(Roles = AppRoles.Admin)]
@using Microsoft.AspNetCore.Components.Forms
@using HealthAxis.Shared.Constants
@using HealthAxis.Shared.Dtos.Auth
@inject IAuthService AuthService

<PageTitle>Admin Profile - HealthAxis Admin</PageTitle>

<AdminPageHeader Kicker="Profile"
                 Title="Admin Profile" />

<section class="admin-card profile-card-clean">
    <div class="profile-summary">
        <div class="profile-summary-avatar">A</div>
        <div>
            <h3 class="mb-1">Admin User</h3>
            <p class="text-muted mb-0">Change your admin login password.</p>
        </div>
    </div>

    <EditForm EditContext="_changePasswordEditContext"
              OnValidSubmit="ChangePasswordAsync"
              OnInvalidSubmit="HandleInvalidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="profile-form-stack">
            <div>
                <label class="form-label">Current password</label>
                <InputText class="form-control" type="password" @bind-Value="_changePasswordForm.CurrentPassword" />
                <ValidationMessage For="@(() => _changePasswordForm.CurrentPassword)" />
            </div>

            <div>
                <label class="form-label">New password</label>
                <InputText class="form-control" type="password" @bind-Value="_changePasswordForm.NewPassword" />
                <ValidationMessage For="@(() => _changePasswordForm.NewPassword)" />
                <div class="form-text">
                    Must be 8-100 characters and include uppercase, lowercase, number, and special character.
                </div>
            </div>

            <div>
                <label class="form-label">Confirm new password</label>
                <InputText class="form-control" type="password" @bind-Value="_changePasswordForm.ConfirmNewPassword" />
                <ValidationMessage For="@(() => _changePasswordForm.ConfirmNewPassword)" />
            </div>
        </div>

        <div class="form-actions">
            <button class="btn btn-soft-primary" type="submit" disabled="@_isSaving">
                @(_isSaving ? "Changing..." : "Change password")
            </button>
            <button class="btn btn-soft-secondary" type="button" @onclick="ResetForm" disabled="@_isSaving">
                Reset
            </button>
        </div>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="alert alert-danger mt-3">@_errorMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(_successMessage))
        {
            <div class="alert alert-success mt-3">@_successMessage</div>
        }
    </EditForm>
</section>

@code {
    private ChangePasswordDto _changePasswordForm = new();
    private EditContext _changePasswordEditContext = default!;
    private bool _isSaving;
    private string? _errorMessage;
    private string? _successMessage;

    protected override void OnInitialized()
    {
        ResetPasswordFields();
    }

    private async Task ChangePasswordAsync()
    {
        _errorMessage = null;
        _successMessage = null;

        if (_changePasswordForm.CurrentPassword == _changePasswordForm.NewPassword)
        {
            _errorMessage = "New password must be different from the current password.";
            return;
        }

        if (!IsStrongPassword(_changePasswordForm.NewPassword))
        {
            _errorMessage = "New password must include uppercase, lowercase, number, and special character.";
            return;
        }

        _isSaving = true;

        try
        {
            var message = await AuthService.ChangePasswordAsync(_changePasswordForm);

            if (string.IsNullOrWhiteSpace(message) ||
                !message.Contains("success", StringComparison.OrdinalIgnoreCase))
            {
                _errorMessage = message ?? "Unable to change password.";
                return;
            }

            _successMessage = message;
            ResetPasswordFields();
        }
        catch
        {
            _errorMessage = "Unable to change password.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void HandleInvalidSubmit()
    {
        _errorMessage = "Please correct the highlighted fields before changing the password.";
        _successMessage = null;
    }

    private void ResetForm()
    {
        ResetPasswordFields();
        _errorMessage = null;
        _successMessage = null;
    }

    private void ResetPasswordFields()
    {
        _changePasswordForm = new ChangePasswordDto();
        _changePasswordEditContext = new EditContext(_changePasswordForm);
    }

    private static bool IsStrongPassword(string password)
    {
        return password.Length is >= 8 and <= 100 &&
            password.Any(char.IsUpper) &&
            password.Any(char.IsLower) &&
            password.Any(char.IsDigit) &&
            password.Any(character => !char.IsLetterOrDigit(character));
    }
}

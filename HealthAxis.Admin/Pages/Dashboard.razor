@page "/dashboard"
@attribute [Authorize(Roles = AppRoles.Admin)]
@using HealthAxis.Admin.Components
@using HealthAxis.Shared.Constants
@using HealthAxis.Shared.Dtos
@using HealthAxis.Shared.Dtos.Appointment
@using HealthAxis.Shared.Enums
@inject IAdminDashboardService AdminDashboardService
@inject IAdminReportService AdminReportService

<PageTitle>Dashboard - HealthAxis Admin</PageTitle>

<AdminPageHeader Kicker="Overview" Title="Dashboard" />

@if (_isLoadingSummary)
{
    <section class="admin-card mb-4">
        <p class="mb-0">Loading dashboard...</p>
    </section>
}

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger">@_errorMessage</div>
}

@if (!string.IsNullOrWhiteSpace(_successMessage))
{
    <div class="alert alert-success">@_successMessage</div>
}

<div class="admin-stats-grid">
    <AdminStatCard Label="Active Doctors"
                   Value="@_summary.ActiveDoctorsCount.ToString()" />

    <AdminStatCard Label="Patients"
                   Value="@_summary.RegisteredPatientsCount.ToString()" />

    <AdminStatCard Label="Pending Appointments"
                   Value="@_summary.PendingAppointmentsCount.ToString()" />

    <AdminStatCard Label="Completed Appointments"
                   Value="@_summary.CompletedAppointmentsCount.ToString()" />
</div>

<section class="dashboard-management-grid mt-4">
    <a class="dashboard-management-button" href="doctors">
        <span class="bi bi-person-badge"></span>
        <span>Doctor Management</span>
    </a>

    <a class="dashboard-management-button" href="patients">
        <span class="bi bi-people"></span>
        <span>Patient Management</span>
    </a>
</section>

<section class="admin-card mt-4">
    <div class="admin-card-header align-items-center">
        <div>
            <h3>Today's Appointments</h3>
            <p>@Today.ToString("dd MMM yyyy")</p>
        </div>

        <a class="btn btn-soft-primary view-all-button" href="appointment-reports">
            View all
        </a>
    </div>

    @if (_isLoadingTodayAppointments)
    {
        <p>Loading appointments...</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table admin-table align-middle appointment-clean-table">
                <thead>
                    <tr>
                        <th>Time</th>
                        <th>Patient</th>
                        <th>Doctor</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (_todayAppointments.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                No appointments scheduled for today.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var appointment in _todayAppointments)
                        {
                            <tr @key="appointment.Id">
                                <td>@appointment.AppointmentTime.ToString("hh:mm tt")</td>
                                <td>@appointment.PatientName</td>
                                <td>Dr. @appointment.DoctorName</td>
                                <td>
                                    <StatusBadge Text="@appointment.Status.ToString()"
                                                 Variant="@GetAppointmentStatusVariant(appointment.Status)" />
                                </td>
                                <td class="appointment-context-cell">
                                    @if (appointment.Status == AppointmentStatus.Pending)
                                    {
                                        <button class="btn btn-soft-danger btn-sm me-2"
                                                type="button"
                                                disabled="@_isSavingStatus"
                                                @onclick="() => OpenCancelAppointmentModal(appointment)">
                                            Cancel
                                        </button>

                                        <button class="btn btn-soft-success btn-sm"
                                                type="button"
                                                disabled="@_isSavingStatus"
                                                @onclick="() => ConfirmAppointmentAsync(appointment)">
                                            Confirm
                                        </button>
                                    }
                                    else if (appointment.Status == AppointmentStatus.Confirmed)
                                    {
                                        <button class="btn btn-soft-danger btn-sm"
                                                type="button"
                                                disabled="@_isSavingStatus"
                                                @onclick="() => OpenCancelAppointmentModal(appointment)">
                                            Cancel
                                        </button>
                                    }
                                    else if (appointment.Status == AppointmentStatus.Cancelled && !string.IsNullOrWhiteSpace(appointment.CancellationReason))
                                    {
                                        <button class="btn btn-soft-secondary btn-sm"
                                                type="button"
                                                @onclick="() => OpenCancellationReasonModal(appointment)">
                                            Reason
                                        </button>
                                    }
                                    else if (appointment.Status == AppointmentStatus.Cancelled)
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                    else if (appointment.Status == AppointmentStatus.Completed && appointment.HealthRecordId is not null)
                                    {
                                        <span class="status-detail text-success">Health Record #@appointment.HealthRecordId</span>
                                    }
                                    else if (appointment.Status == AppointmentStatus.Completed)
                                    {
                                        <span class="status-detail text-warning">Health Record Missing</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }

    @if (_todayAppointmentPagedResult is not null && _todayAppointmentPagedResult.TotalPages > 1)
    {
        <div class="d-flex justify-content-between align-items-center mt-3">
            <button class="btn btn-soft-secondary btn-sm"
                    type="button"
                    disabled="@(!_todayAppointmentPagedResult.HasPreviousPage || _isLoadingTodayAppointments)"
                    @onclick="PreviousTodayAppointmentPageAsync">
                Previous
            </button>

            <span class="text-muted">Page @_todayAppointmentPagination.PageNumber of @_todayAppointmentPagedResult.TotalPages</span>

            <button class="btn btn-soft-secondary btn-sm"
                    type="button"
                    disabled="@(!_todayAppointmentPagedResult.HasNextPage || _isLoadingTodayAppointments)"
                    @onclick="NextTodayAppointmentPageAsync">
                Next
            </button>
        </div>
    }
</section>

<CancelAppointmentModal IsOpen="_showCancelModal"
                        Appointment="_appointmentPendingCancellation"
                        CancellationReason="_cancellationReason"
                        CancellationReasonChanged="@((string value) => _cancellationReason = value)"
                        IsSaving="_isSavingStatus"
                        OnConfirm="CancelAppointmentAsync"
                        OnClose="CloseCancelAppointmentModal" />

@if (_showReasonModal && _appointmentReasonToView is not null)
{
    <div class="modal-backdrop-custom">
        <section class="confirm-modal-card">
            <h3>Cancellation reason</h3>
            <p>
                Appointment with <strong>@_appointmentReasonToView.PatientName</strong>
                at <strong>@_appointmentReasonToView.AppointmentTime.ToString("hh:mm tt")</strong>
            </p>

            <div class="mb-3 text-start">
                <p class="form-control-plaintext border rounded p-3 bg-light mb-0 text-wrap">
                    @_appointmentReasonToView.CancellationReason
                </p>
            </div>

            <div class="form-actions">
                <button class="btn btn-soft-secondary" type="button" @onclick="CloseCancellationReasonModal">
                    Close
                </button>
            </div>
        </section>
    </div>
}

@code {
    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Today);

    private readonly PaginationQueryDto _todayAppointmentPagination = new()
    {
        PageNumber = 1,
        PageSize = 10
    };

    private AdminDashboardSummaryDto _summary = new();
    private PagedResultDto<AppointmentDto>? _todayAppointmentPagedResult;
    private List<AppointmentDto> _todayAppointments = new();

    private bool _isLoadingSummary;
    private bool _isLoadingTodayAppointments;
    private bool _showCancelModal;
    private bool _showReasonModal;
    private bool _isSavingStatus;

    private string? _errorMessage;
    private string? _successMessage;
    private string _cancellationReason = string.Empty;

    private AppointmentDto? _appointmentPendingCancellation;
    private AppointmentDto? _appointmentReasonToView;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardSummaryAsync();
        await LoadTodayAppointmentsAsync();
    }

    private async Task LoadDashboardSummaryAsync()
    {
        _isLoadingSummary = true;
        _errorMessage = null;

        try
        {
            _summary = await AdminDashboardService.GetDashboardSummaryAsync();
        }
        catch
        {
            _errorMessage = "Unable to load dashboard.";
        }
        finally
        {
            _isLoadingSummary = false;
        }
    }

    private async Task LoadTodayAppointmentsAsync()
    {
        _isLoadingTodayAppointments = true;
        _errorMessage = null;

        try
        {
            _todayAppointmentPagedResult = await AdminReportService.GetAppointmentReportDetailsAsync(
                Today,
                null,
                _todayAppointmentPagination);

            _todayAppointments = _todayAppointmentPagedResult.Items;
        }
        catch
        {
            _errorMessage = "Unable to load today's appointments.";
        }
        finally
        {
            _isLoadingTodayAppointments = false;
        }
    }

    private async Task PreviousTodayAppointmentPageAsync()
    {
        if (_todayAppointmentPagination.PageNumber <= 1)
        {
            return;
        }

        _todayAppointmentPagination.PageNumber--;
        await LoadTodayAppointmentsAsync();
    }

    private async Task NextTodayAppointmentPageAsync()
    {
        if (_todayAppointmentPagedResult?.HasNextPage != true)
        {
            return;
        }

        _todayAppointmentPagination.PageNumber++;
        await LoadTodayAppointmentsAsync();
    }

    private async Task ConfirmAppointmentAsync(AppointmentDto appointment)
    {
        _isSavingStatus = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            var result = await AdminReportService.UpdateAppointmentStatusAsync(
                appointment.Id,
                new UpdateAppointmentStatusDto { Status = AppointmentStatus.Confirmed });

            if (!result.IsSuccess)
            {
                _errorMessage = result.ErrorMessage ?? "Unable to confirm appointment.";
                return;
            }

            _successMessage = "Appointment confirmed.";
            await LoadDashboardSummaryAsync();
            await LoadTodayAppointmentsAsync();
        }
        catch
        {
            _errorMessage = "Unable to confirm appointment.";
        }
        finally
        {
            _isSavingStatus = false;
        }
    }

    private void OpenCancelAppointmentModal(AppointmentDto appointment)
    {
        _appointmentPendingCancellation = appointment;
        _cancellationReason = string.Empty;
        _errorMessage = null;
        _successMessage = null;
        _showCancelModal = true;
    }

    private async Task CancelAppointmentAsync()
    {
        if (_appointmentPendingCancellation is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_cancellationReason))
        {
            _errorMessage = "Cancellation reason is required.";
            return;
        }

        _isSavingStatus = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            var result = await AdminReportService.UpdateAppointmentStatusAsync(
                _appointmentPendingCancellation.Id,
                new UpdateAppointmentStatusDto
                {
                    Status = AppointmentStatus.Cancelled,
                    CancellationReason = _cancellationReason.Trim()
                });

            if (!result.IsSuccess)
            {
                _errorMessage = result.ErrorMessage ?? "Unable to cancel appointment.";
                return;
            }

            _successMessage = "Appointment cancelled.";
            CloseCancelAppointmentModal();
            await LoadDashboardSummaryAsync();
            await LoadTodayAppointmentsAsync();
        }
        catch
        {
            _errorMessage = "Unable to cancel appointment.";
        }
        finally
        {
            _isSavingStatus = false;
        }
    }

    private void CloseCancelAppointmentModal()
    {
        _showCancelModal = false;
        _appointmentPendingCancellation = null;
        _cancellationReason = string.Empty;
    }

    private void OpenCancellationReasonModal(AppointmentDto appointment)
    {
        _appointmentReasonToView = appointment;
        _showReasonModal = true;
    }

    private void CloseCancellationReasonModal()
    {
        _showReasonModal = false;
        _appointmentReasonToView = null;
    }

    private static string GetAppointmentStatusVariant(AppointmentStatus status)
    {
        return status switch
        {
            AppointmentStatus.Pending => "warning",
            AppointmentStatus.Confirmed => "success",
            AppointmentStatus.Cancelled => "danger",
            AppointmentStatus.Completed => "info",
            _ => "neutral"
        };
    }
}

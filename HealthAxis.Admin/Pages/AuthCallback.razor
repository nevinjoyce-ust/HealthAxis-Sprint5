@page "/auth/callback"

@using System.Net.Http.Json
@using HealthAxis.Admin.Auth
@using HealthAxis.Admin.Services
@using HealthAxis.Shared.Dtos.Auth
@using Microsoft.AspNetCore.WebUtilities

@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject ITokenService TokenService
@inject CustomAuthenticationStateProvider AuthStateProvider

<section class="p-4">
    <h1>Signing you in...</h1>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <p class="text-danger">@_errorMessage</p>
        <a href="/login">Return to login</a>
    }
</section>

@code {
    private string _errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (!query.TryGetValue("code", out var codeValues))
        {
            _errorMessage = "Missing admin handoff code.";
            return;
        }

        var code = codeValues.FirstOrDefault();

        if (string.IsNullOrWhiteSpace(code))
        {
            _errorMessage = "Invalid admin handoff code.";
            return;
        }

        var response = await Http.PostAsJsonAsync(
            "api/admin-handoff/exchange",
            new AdminHandoffExchangeDto
            {
                Code = code
            });

        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Unable to complete admin sign-in.";
            return;
        }

        var authResponse = await response.Content
            .ReadFromJsonAsync<AuthResponseDto>();

        if (authResponse == null ||
            string.IsNullOrWhiteSpace(authResponse.AccessToken))
        {
            _errorMessage =
                "Admin sign-in response did not include an access token.";
            return;
        }

        await TokenService.SetAccessTokenAsync(authResponse.AccessToken);
        AuthStateProvider.NotifyUserLoggedIn(authResponse.AccessToken);

        NavigationManager.NavigateTo("dashboard", replace: true);
    }
}
